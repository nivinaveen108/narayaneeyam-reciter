      "scripts": {
        "devanagari": [
          "मयूरकेकाशतलोभनीयं मयूखमालाशबलं मणीनाम् ।",
          "विरिञ्चलोकस्पृशमुच्चशृङ्गैर्गिरिं च गोवर्धनमैक्षथास्त्वम् ॥८॥",
          "मयूर-केका-शत-\twith the peacocks' many calls",
          "लोभनीयं\t(which was) resonant"
        ],
        "iast": [
          "mayūrakekāśatalobhanīyaṃ mayūkhamālāśabalaṃ maṇīnām |",
