      "scripts": {
        "devanagari": [
          "अरालमार्गागतनिर्मलापां मरालकूजाकृतनर्मलापाम् ।",
          "निरन्तरस्मेरसरोजवक्त्रां कलिन्दकन्यां समलोकयस्त्वम् ॥७॥",
          "अराल-मार्ग-\tin winding ways",
          "आगत्-निर्मल-आपां\tflowing with clear waters"
        ],
        "iast": [
          "arālamārgāgatanirmalāpāṃ marālakūjākṛtanarmalāpām |",
          "nirantarasmerasarojavaktrāṃ kalindakanyāṃ samalokayastvam ||7||",
          "arāla-mārga-\tin winding ways",
          "āgat-nirmala-āpāṃ\tflowing with clear waters"
        ],
        "malayalam": [
          "അരാലമാർഗാഗതനിർമലാപാം മരാലകൂജാകൃതനർമലാപാം .",
          "നിരന്തരസ്മേരസരോജവക്ത്രാം കലിന്ദകന്യാം സമലോകയസ്ത്വം ..7..",
          "കാളിന്ദയുടെ പുത്രി, കാളിന്ദി അല്ലെങ്കിൽ യമുനാ നദി വളഞ്ഞുപുളഞ്ഞ വഴികളിലൂടെ തെളിഞ്ഞ വെള്ളത്താൽ ഒഴുകുന്നത് നീ കണ്ടു. ഹംസങ്ങളുടെ കൂവലിൻ്റെ പ്രതിധ്വനികൾ നദിയുടെ മധുരനാദത്തെ വർദ്ധിപ്പിച്ചു. നിറഞ്ഞു തുളുമ്പിയ താമരകളുടെ കട്ടിയുള്ള വളർച്ച അവളുടെ എപ്പോഴും ചിരിക്കുന്ന മുഖം പോലെയായിരുന്നു."
        ],
