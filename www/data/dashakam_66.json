      "scripts": {
        "devanagari": [
          "चन्द्रकरस्यन्दलसत्सुन्दरयमुनातटान्तवीथीषु ।",
          "गोपीजनोत्तरीयैरापादितसंस्तरो न्यषीदस्त्वम् ॥५॥",
          "चन्द्रकर-\tthe moon light",
          "स्यन्द-लसत्-\tflowing and shining"
        ],
        "iast": [
          "candrakarasyandalasatsundarayamunātaṭāntavīthīṣu |",
          "gopījanottarīyairāpāditasaṃstaro nyaṣīdastvam ||5||",
          "candrakara-\tthe moon light",
          "syanda-lasat-\tflowing and shining"
        ],
        "malayalam": [
          "ചന്ദ്രകരസ്യന്ദലസത്സുന്ദരയമുനാതടാന്തവീഥീഷു .",
          "ഗോപീജനോത്തരീയൈരാപാദിതസംസ്തരോ ന്യഷീദസ്ത്വം ..5..",
          "യമുനയുടെ മണൽത്തീരങ്ങൾ മനോഹരമായി ഒഴുകുകയും തിളങ്ങുകയും ചെയ്യുന്ന ചന്ദ്രപ്രകാശത്താൽ തിളങ്ങി. അവിടെ ഗോപികമാർ മേൽവസ്ത്രം വിരിച്ച് ഉണ്ടാക്കിയ കട്ടിലിൽ നീ ഇരുന്നു."
        ],
