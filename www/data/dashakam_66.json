      "scripts": {
        "devanagari": [
          "उपयातानां सुदृशां कुसुमायुधबाणपातविवशानाम् ।",
          "अभिवाञ्छितं विधातुं कृतमतिरपि ता जगाथ वाममिव ॥१॥",
          "उपयातानां\twho had come",
          "सुदृशां\tthe beautiful women"
        ],
        "iast": [
          "upayātānāṃ sudṛśāṃ kusumāyudhabāṇapātavivaśānām |",
          "abhivāñchitaṃ vidhātuṃ kṛtamatirapi tā jagātha vāmamiva ||1||",
          "upayātānāṃ\twho had come",
          "sudṛśāṃ\tthe beautiful women"
        ],
        "malayalam": [
          "ഉപയാതാനാം സുദൃശാം കുസുമായുധബാണപാതവിവശാനാം .",
          "അഭിവാഞ്ഛിതം വിധാതും കൃതമതിരപി താ ജഗാഥ വാമമിവ ..1..",
          "നിൻ്റെ അടുക്കൽ വന്ന സുന്ദരിമാരുടെ ആഗ്രഹം നിറവേറ്റാൻ നീ തീരുമാനിച്ചു. നിനക്കു വേണ്ടി കാമദേവൻ്റെ അസ്ത്രത്താൽ അവർ നിസ്സഹായരായി. എന്നിട്ടും നീ ആദ്യം അവരോട് പ്രതികൂലമായ രീതിയിൽ സംസാരിച്ചു."
        ],
