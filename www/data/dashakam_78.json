    {
      "shloka": 3,
      "start": 39.0,
      "end": 60.0,
      "scripts": {
        "devanagari": [
          "अथ विदर्भसुतां खलु रुक्मिणीं प्रणयिनीं त्वयि देव सहोदर: ।",
          "स्वयमदित्सत चेदिमहीभुजे स्वतमसा तमसाधुमुपाश्रयन् ॥३॥",
          "अथ विदर्भ-सुतां\tthen, king of Vidarbh's (Bheeshmaka's) daughter",
          "खलु रुक्मिणीं\tindeed Rukmini"
        ],
        "iast": [
          "atha vidarbhasutāṃ khalu rukmiṇīṃ praṇayinīṃ tvayi deva sahodara: |",
          "svayamaditsata cedimahībhuje svatamasā tamasādhumupāśrayan ||3||",
          "atha vidarbha-sutāṃ\tthen, king of Vidarbh's (Bheeshmaka's) daughter",
          "khalu rukmiṇīṃ\tindeed Rukmini"
        ],
        "malayalam": [
          "അഥ വിദർഭസുതാം ഖലു രുക്മിണീം പ്രണയിനീം ത്വയി ദേവ സഹോദര: .",
          "സ്വയമദിത്സത ചേദിമഹീഭുജേ സ്വതമസാ തമസാധുമുപാശ്രയൻ ..3..",
          "വിദർഭ് രാജാവിൻ്റെ (ഭീഷ്മക) മകൾ രുക്മിണി യഥാർത്ഥത്തിൽ നിന്നോട് പ്രണയത്തിലായിരുന്നു. ഭഗവാനേ! അവളുടെ സഹോദരൻ രുക്മി തൻ്റെ തമസ്ഗുണത്താൽ ഉണ്ടായ അജ്ഞത നിമിത്തം അവളെ ചേദിരാജാവായ ശിശുപാലന് കൊടുക്കാൻ സ്വന്തം ഇഷ്ടം തീരുമാനിച്ചു. തികച്ചും സദാചാരമില്ലാത്ത ശിശുപാലുമായി രുക്മി സൗഹൃദം സ്ഥാപിച്ചിരുന്നു."
        ],
        "tamil": []
      },
