      "scripts": {
        "devanagari": [
          "स च भवन्तमवोचत कुण्डिने नृपसुता खलु राजति रुक्मिणी ।",
          "त्वयि समुत्सुकया निजधीरतारहितया हि तया प्रहितोऽस्म्यहम् ॥६॥",
          "स च\the and",
          "भवन्तम्-अवोचत\tto Thee said"
        ],
        "iast": [
          "sa ca bhavantamavocata kuṇḍine nṛpasutā khalu rājati rukmiṇī |",
          "tvayi samutsukayā nijadhīratārahitayā hi tayā prahito'smyaham ||6||",
          "sa ca\the and",
          "bhavantam-avocata\tto Thee said"
        ],
        "malayalam": [
          "സ ച ഭവന്തമവോചത കുണ്ഡിനേ നൃപസുതാ ഖലു രാജതി രുക്മിണീ .",
          "ത്വയി സമുത്സുകയാ നിജധീരതാരഹിതയാ ഹി തയാ പ്രഹിതോഽസ്മ്യഹം ..6..",
          "അവൻ നിന്നോട് പറഞ്ഞു 'കുണ്ഡിനയിൽ (വിദർഭയുടെ തലസ്ഥാനം) കുലീനയായ രാജകുമാരി രുക്മിണി താമസിക്കുന്നു. അവൾ നിന്നോട് അഗാധമായ പ്രണയത്തിലാണ്. സ്വന്തം സംയമനം നഷ്ടപ്പെട്ടവൾ എന്നെ ഇങ്ങോട്ടയച്ചിരിക്കുന്നു.'"
        ],
