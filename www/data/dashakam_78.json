      "scripts": {
        "devanagari": [
          "त्रिदिववर्धकिवर्धितकौशलं त्रिदशदत्तसमस्तविभूतिमत् ।",
          "जलधिमध्यगतं त्वमभूषयो नवपुरं वपुरञ्चितरोचिषा ॥१॥",
          "त्रिदिव-वर्धकि-\theaven's architect",
          "वर्धित-कौशलं\texcelling the skill"
        ],
        "iast": [
          "tridivavardhakivardhitakauśalaṃ tridaśadattasamastavibhūtimat |",
          "jaladhimadhyagataṃ tvamabhūṣayo navapuraṃ vapurañcitarociṣā ||1||",
          "tridiva-vardhaki-\theaven's architect",
          "vardhita-kauśalaṃ\texcelling the skill"
        ],
        "malayalam": [
          "ത്രിദിവവർധകിവർധിതകൗശലം ത്രിദശദത്തസമസ്തവിഭൂതിമത് .",
          "ജലധിമധ്യഗതം ത്വമഭൂഷയോ നവപുരം വപുരഞ്ചിതരോചിഷാ ..1..",
          "ദൈവിക വാസ്തുശില്പിയായ വിശ്വകർമ്മാവ് അത് നിർമ്മിക്കുന്നതിൽ തൻ്റെ എല്ലാ മികച്ച കഴിവുകളും ഉപയോഗിച്ചിരുന്നുവെങ്കിലും, സമുദ്രമധ്യത്തിൽ സ്ഥിതി ചെയ്യുന്ന നഗരത്തിന് ദേവന്മാർ അവരുടെ എല്ലാ ദിവ്യ അലങ്കാരങ്ങളും സമൃദ്ധമായി നൽകിയിരുന്നുവെങ്കിലും, അത് നിങ്ങളുടെ രൂപത്തിൻ്റെ പ്രകടമായ ശോഭയാൽ അലങ്കരിച്ചിരുന്നു."
        ],
        "tamil": []
