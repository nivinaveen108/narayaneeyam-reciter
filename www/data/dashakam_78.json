      "end": 81.0,
      "scripts": {
        "devanagari": [
          "चिरधृतप्रणया त्वयि बालिका सपदि काङ्क्षितभङ्गसमाकुला ।",
          "तव निवेदयितुं द्विजमादिशत् स्वकदनं कदनङ्गविनिर्मितं ॥४॥",
          "चिर-धृत-प्रणया\tfor long holding love",
          "त्वयि बालिका\tfor Thee, the girl"
        ],
        "iast": [
          "ciradhṛtapraṇayā tvayi bālikā sapadi kāṅkṣitabhaṅgasamākulā |",
          "tava nivedayituṃ dvijamādiśat svakadanaṃ kadanaṅgavinirmitaṃ ||4||",
          "cira-dhṛta-praṇayā\tfor long holding love",
          "tvayi bālikā\tfor Thee, the girl"
        ],
        "malayalam": [
          "ചിരധൃതപ്രണയാ ത്വയി ബാലികാ സപദി കാങ്ക്ഷിതഭംഗസമാകുലാ .",
          "തവ നിവേദയിതും ദ്വിജമാദിശത് സ്വകദനം കദനംഗവിനിർമിതം ..4..",
          "ക്രൂരനായ കാമദേവൻ സൃഷ്ടിച്ച നിന്നോട് വളരെക്കാലമായി പ്രണയം മുറുകെ പിടിച്ച്, പെൺകുട്ടി ഉടൻ തന്നെ ഒരു ബ്രാഹ്മണനോട് തൻ്റെ ആഗ്രഹത്തിൻ്റെ പൂർത്തീകരണത്തിന് ഭീഷണിയായതിനാൽ തൻ്റെ വിഷമം നിന്നെ അറിയിക്കാൻ നിർദ്ദേശിച്ചു."
        ],
