      "end": 141.0,
      "scripts": {
        "devanagari": [
          "तव हृताऽस्मि पुरैव गुणैरहं हरति मां किल चेदिनृपोऽधुना ।",
          "अयि कृपालय पालय मामिति प्रजगदे जगदेकपते तया ॥७॥",
          "तव हृता-अस्मि\tby Thee captivated am I",
          "पुरा-एव\tsince long even"
        ],
        "iast": [
          "tava hṛtā'smi puraiva guṇairahaṃ harati māṃ kila cedinṛpo'dhunā |",
          "ayi kṛpālaya pālaya māmiti prajagade jagadekapate tayā ||7||",
          "tava hṛtā-asmi\tby Thee captivated am I",
          "purā-eva\tsince long even"
        ],
        "malayalam": [
          "തവ ഹൃതാഽസ്മി പുരൈവ ഗുണൈരഹം ഹരതി മാം കില ചേദിനൃപോഽധുനാ .",
          "അയി കൃപാലയ പാലയ മാമിതി പ്രജഗദേ ജഗദേകപതേ തയാ ..7..",
          "പണ്ടുമുതലേ ഞാൻ അങ്ങയുടെ ശ്രേഷ്ഠതകളുടെ തടവുകാരനാണ്. ഇപ്പോൾ ചേദി രാജാവ് (ശിശുപാൽ) എന്നെ വശീകരിക്കാൻ പോകുന്നു. കാരുണ്യത്തിൻ്റെ വാസസ്ഥലമേ! എന്നെ രക്ഷിക്കൂ.' ലോകങ്ങളുടെ രക്ഷിതാവേ! അങ്ങനെ അവൾ നിന്നോട് പ്രാർത്ഥിച്ചു."
        ],
