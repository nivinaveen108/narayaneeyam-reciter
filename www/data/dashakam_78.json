      "scripts": {
        "devanagari": [
          "अशरणां यदि मां त्वमुपेक्षसे सपदि जीवितमेव जहाम्यहम् ।",
          "इति गिरा सुतनोरतनोत् भृशं सुहृदयं हृदयं तव कातरम् ॥८॥",
          "अशरणाम्\thelpless",
          "यदि मां\tif me"
        ],
        "iast": [
          "aśaraṇāṃ yadi māṃ tvamupekṣase sapadi jīvitameva jahāmyaham |",
          "iti girā sutanoratanot bhṛśaṃ suhṛdayaṃ hṛdayaṃ tava kātaram ||8||",
          "aśaraṇām\thelpless",
          "yadi māṃ\tif me"
        ],
        "malayalam": [
          "അശരണാം യദി മാം ത്വമുപേക്ഷസേ സപദി ജീവിതമേവ ജഹാമ്യഹം .",
          "ഇതി ഗിരാ സുതനോരതനോത് ഭൃശം സുഹൃദയം ഹൃദയം തവ കാതരം ..8..",
          "നിസ്സഹായനായ എന്നെ നീ ഉപേക്ഷിക്കുകയാണെങ്കിൽ, തീർച്ചയായും ഞാൻ എൻ്റെ ജീവിതം ഉടൻ അവസാനിപ്പിക്കും. നല്ല മനസ്സുള്ള ബ്രാഹ്മണനിൽ നിന്നുള്ള സുന്ദരിയായ രുക്മിണിയുടെ ഈ തിരുമ്മൽ അങ്ങയുടെ ഹൃദയത്തിൽ ആഴത്തിലുള്ള അസ്വസ്ഥത സൃഷ്ടിച്ചു."
        ],
