      "scripts": {
        "devanagari": [
          "बहुतरजनताहिताय तत्र त्वमपि पुनन् विनिमज्य तीर्थतोयम् ।",
          "द्विजगणपरिमुक्तवित्तराशि: सममिलथा: कुरुपाण्डवादिमित्रै: ॥२॥",
          "बहुतर-जनता-हिताय\tfor the large number of peoples benefit",
          "तत्र त्वम्-अपि\tthere Thou also"
        ],
        "iast": [
          "bahutarajanatāhitāya tatra tvamapi punan vinimajya tīrthatoyam |",
          "dvijagaṇaparimuktavittarāśi: samamilathā: kurupāṇḍavādimitrai: ||2||",
          "bahutara-janatā-hitāya\tfor the large number of peoples benefit",
          "tatra tvam-api\tthere Thou also"
        ],
        "malayalam": [
          "ബഹുതരജനതാഹിതായ തത്ര ത്വമപി പുനൻ വിനിമജ്യ തീർഥതോയം .",
          "ദ്വിജഗണപരിമുക്തവിത്തരാശി: സമമിലഥാ: കുരുപാണ്ഡവാദിമിത്രൈ: ..2..",
          "നീയും പുണ്യജലത്തിൽ മുങ്ങി, ധാരാളം ആളുകൾക്ക് പ്രയോജനത്തിനായി ജലം വിശുദ്ധീകരിച്ചു. ബ്രാഹ്മണരുടെ സംഘത്തിനും നീ നല്ല തുക നൽകി. അപ്പോൾ നീ നിൻ്റെ സുഹൃത്തുക്കളായ കൗരവരും പാണ്ഡവരും മറ്റുള്ളവരുമായി സംവദിച്ചു."
        ],
