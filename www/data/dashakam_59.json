      "scripts": {
        "devanagari": [
          "त्वद्वपुर्नवकलायकोमलं प्रेमदोहनमशेषमोहनम् ।",
          "ब्रह्म तत्त्वपरचिन्मुदात्मकं वीक्ष्य सम्मुमुहुरन्वहं स्त्रिय: ॥१॥",
          "त्वत्-वपु:-\tThy form",
          "नव-कलाय-कोमलं\tfresh Kalaaya flower like soft"
        ],
        "iast": [
          "tvadvapurnavakalāyakomalaṃ premadohanamaśeṣamohanam |",
          "brahma tattvaparacinmudātmakaṃ vīkṣya sammumuhuranvahaṃ striya: ||1||",
          "tvat-vapu:-\tThy form",
          "nava-kalāya-komalaṃ\tfresh Kalaaya flower like soft"
        ],
        "malayalam": [
          "ത്വദ്വപുർനവകലായകോമലം പ്രേമദോഹനമശേഷമോഹനം .",
          "ബ്രഹ്മ തത്ത്വപരചിന്മുദാത്മകം വീക്ഷ്യ സമ്മുമുഹുരന്വഹം സ്ത്രിയ: ..1..",
          "ദിനംപ്രതി ഗോപികമാർ അങ്ങയുടെ രൂപം കണ്ടു വശീകരിക്കപ്പെട്ടു. നിൻ്റെ രൂപം മനോഹരവും പുതുമയുള്ളതും കാലായ പുഷ്പം പോലെ മൃദുവും പ്രണയത്തിൻ്റെ വികാരം ഉണർത്തുന്നു. നിങ്ങളുടെ രൂപം എല്ലാവരെയും ആകർഷിക്കുന്നു. നിങ്ങളുടെ രൂപം, ബ്രഹ്മം, അസ്തിത്വം, യാഥാർത്ഥ്യം, പരമമായ ബോധം, ആനന്ദം (സത്-ചിത്-ആനന്ദ) എന്നിവയുടെ വ്യക്തിത്വമാണ്."
        ],
        "tamil": []
