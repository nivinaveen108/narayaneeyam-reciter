      "scripts": {
        "devanagari": [
          "मारबाणधुतखेचरीकुलं निर्विकारपशुपक्षिमण्डलम् ।",
          "द्रावणं च दृषदामपि प्रभो तावकं व्यजनि वेणुकूजितम् ॥५॥",
          "मार-बाण-धुत-\tby Cupid's arrows shaken",
          "खेचरी-कुलं\tthe celestial damsels"
        ],
        "iast": [
          "mārabāṇadhutakhecarīkulaṃ nirvikārapaśupakṣimaṇḍalam |",
          "drāvaṇaṃ ca dṛṣadāmapi prabho tāvakaṃ vyajani veṇukūjitam ||5||",
          "māra-bāṇa-dhuta-\tby Cupid's arrows shaken",
          "khecarī-kulaṃ\tthe celestial damsels"
        ],
        "malayalam": [
          "മാരബാണധുതഖേചരീകുലം നിർവികാരപശുപക്ഷിമണ്ഡലം .",
          "ദ്രാവണം ച ദൃഷദാമപി പ്രഭോ താവകം വ്യജനി വേണുകൂജിതം ..5..",
          "ഭഗവാനേ! നിൻ്റെ ഓടക്കുഴലിൽ നിന്ന് പിറന്ന സംഗീതം കാമദേവൻ്റെ അസ്ത്രങ്ങളാൽ ആകാശത്തിലെ സ്ത്രീകളെ കുലുക്കി. അത് അനവധി മൃഗങ്ങളെയും പക്ഷികളെയും ചലനരഹിതമാക്കി, കല്ലുകളും പാറകളും പോലും ഉരുക്കി."
        ],
