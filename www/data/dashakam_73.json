      "scripts": {
        "devanagari": [
          "करुणानिधिरेष नन्दसूनु: कथमस्मान् विसृजेदनन्यनाथा: ।",
          "बत न: किमु दैवमेवमासीदिति तास्त्वद्गतमानसा विलेपु: ॥२॥",
          "करुणा-निधि:-\tthe compassion repository",
          "एष नन्द-सूनु:\tthis Nanda's son"
        ],
        "iast": [
          "karuṇānidhireṣa nandasūnu: kathamasmān visṛjedananyanāthā: |",
          "bata na: kimu daivamevamāsīditi tāstvadgatamānasā vilepu: ||2||",
          "karuṇā-nidhi:-\tthe compassion repository",
          "eṣa nanda-sūnu:\tthis Nanda's son"
        ],
        "malayalam": [
          "കരുണാനിധിരേഷ നന്ദസൂനു: കഥമസ്മാൻ വിസൃജേദനന്യനാഥാ: .",
          "ബത ന: കിമു ദൈവമേവമാസീദിതി താസ്ത്വദ്ഗതമാനസാ വിലേപു: ..2..",
          "കരുണയുടെ വാസസ്ഥലം, നന്ദപുത്രൻ, കൃഷ്ണൻ, അവനല്ലാതെ മറ്റൊരു താങ്ങുമില്ലാത്ത ഞങ്ങളെ എങ്ങനെ ഉപേക്ഷിക്കും. അയ്യോ നമുക്ക് എന്ത് വിധിയാണ്.' നിന്നിൽ ഉറച്ചുനിന്ന പെൺകുട്ടികൾ വിലപിച്ചു."
        ],
