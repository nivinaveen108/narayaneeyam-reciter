      "scripts": {
        "devanagari": [
          "अचिरादुपयामि सन्निधिं वो भविता साधु मयैव सङ्गमश्री: ।",
          "अमृताम्बुनिधौ निमज्जयिष्ये द्रुतमित्याश्वसिता वधूरकार्षी: ॥४॥",
          "अचिरात्-उपयामि\tvery soon (I) will come back",
          "सन्निधिं व:\tnear you all"
        ],
        "iast": [
          "acirādupayāmi sannidhiṃ vo bhavitā sādhu mayaiva saṅgamaśrī: |",
          "amṛtāmbunidhau nimajjayiṣye drutamityāśvasitā vadhūrakārṣī: ||4||",
          "acirāt-upayāmi\tvery soon (I) will come back",
          "sannidhiṃ va:\tnear you all"
        ],
        "malayalam": [
          "അചിരാദുപയാമി സന്നിധിം വോ ഭവിതാ സാധു മയൈവ സംഗമശ്രീ: .",
          "അമൃതാംബുനിധൗ നിമജ്ജയിഷ്യേ ദ്രുതമിത്യാശ്വസിതാ വധൂരകാർഷീ: ..4..",
          "ഞാൻ ഉടൻ തന്നെ നിങ്ങളുടെ അടുത്തേക്ക് വരും. നിങ്ങൾക്ക് എന്നോടൊപ്പം നല്ലതും സന്തോഷകരവുമായ നിരവധി മീറ്റിംഗുകൾ ഉണ്ടാകും. ഞാൻ നിങ്ങളെ ഉടൻ ആനന്ദസാഗരത്തിൻ്റെ അമൃതിൽ മുക്കും. അങ്ങനെ നീ പെൺകുട്ടികൾക്ക് ആശ്വാസം നൽകി."
