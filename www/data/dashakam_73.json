      "scripts": {
        "devanagari": [
          "चरमप्रहरे प्रतिष्ठमान: सह पित्रा निजमित्रमण्डलैश्च ।",
          "परितापभरं नितम्बिनीनां शमयिष्यन् व्यमुच: सखायमेकम् ॥३॥",
          "चरम-प्रहरे\tin the last part (of night)",
          "प्रतिष्ठमान:\tleaving"
        ],
        "iast": [
          "caramaprahare pratiṣṭhamāna: saha pitrā nijamitramaṇḍalaiśca |",
          "paritāpabharaṃ nitambinīnāṃ śamayiṣyan vyamuca: sakhāyamekam ||3||",
          "carama-prahare\tin the last part (of night)",
          "pratiṣṭhamāna:\tleaving"
        ],
        "malayalam": [
