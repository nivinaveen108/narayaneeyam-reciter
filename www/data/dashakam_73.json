      "scripts": {
        "devanagari": [
          "सविषादभरं सयाच्ञमुच्चै: अतिदूरं वनिताभिरीक्ष्यमाण: ।",
          "मृदु तद्दिशि पातयन्नपाङ्गान् सबलोऽक्रूररथेन निर्गतोऽभू: ॥५॥",
          "सविषादभरं\twith great sorrow",
          "सयाच्ञम्-\tbegging"
        ],
        "iast": [
          "saviṣādabharaṃ sayācñamuccai: atidūraṃ vanitābhirīkṣyamāṇa: |",
          "mṛdu taddiśi pātayannapāṅgān sabalo'krūrarathena nirgato'bhū: ||5||",
          "saviṣādabharaṃ\twith great sorrow",
          "sayācñam-\tbegging"
        ],
        "malayalam": [
          "സവിഷാദഭരം സയാച്ഞമുച്ചൈ: അതിദൂരം വനിതാഭിരീക്ഷ്യമാണ: .",
          "മൃദു തദ്ദിശി പാതയന്നപാംഗാൻ സബലോഽക്രൂരരഥേന നിർഗതോഽഭൂ: ..5..",
          "സ്‌ത്രീകൾ അങ്ങേയറ്റം ഉച്ചത്തിൽ ദയനീയമായി യാചിച്ചുകൊണ്ടും അപേക്ഷിക്കുന്ന കണ്ണുകളോടെ നോക്കിക്കൊണ്ടും നിന്നെ അനുഗമിച്ചു. അങ്ങ് ആ ദിശയിലേക്ക് മൃദുവായ വശങ്ങൾ വീശി ബലരാമനോടൊപ്പം അക്രൂരൻ്റെ രഥത്തിൽ യാത്രയായി."
        ],
