      "scripts": {
        "devanagari": [
          "पुनरेष निमज्य पुण्यशाली पुरुषं त्वां परमं भुजङ्गभोगे ।",
          "अरिकम्बुगदाम्बुजै: स्फुरन्तं सुरसिद्धौघपरीतमालुलोके ॥८॥",
          "पुन:-एष\tagain this (Akrura)",
          "निमज्य\tdipping (in the waters)"
        ],
        "iast": [
          "punareṣa nimajya puṇyaśālī puruṣaṃ tvāṃ paramaṃ bhujaṅgabhoge |",
          "arikambugadāmbujai: sphurantaṃ surasiddhaughaparītamāluloke ||8||",
          "puna:-eṣa\tagain this (Akrura)",
          "nimajya\tdipping (in the waters)"
        ],
        "malayalam": [
          "പുനരേഷ നിമജ്യ പുണ്യശാലീ പുരുഷം ത്വാം പരമം ഭുജംഗഭോഗേ .",
          "അരികംബുഗദാംബുജൈ: സ്ഫുരന്തം സുരസിദ്ധൗഘപരീതമാലുലോകേ ..8..",
          "അക്രൂരൻ വീണ്ടും വെള്ളത്തിൽ മുങ്ങി. ശ്രേഷ്ഠനും ഭാഗ്യവാനും ആയിരുന്ന അങ്ങയെ ശേഷസർപ്പത്തിൻ്റെ ശയനത്തിൽ ചാരിയിരിക്കുന്നതും തട്ടം, ശംഖ്, ഗദ, താമര എന്നിവയാൽ അലംകൃതവും ആയി ഇരിക്കുന്നതും അവൻ കണ്ടു. ദേവഗണങ്ങളാലും വിവിധ സിദ്ധന്മാരാലും നിനക്കു ചുറ്റും ഉണ്ടായിരുന്നു."
        ],
