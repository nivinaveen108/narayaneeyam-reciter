      "end": 87.0,
      "scripts": {
        "devanagari": [
          "अयि ते सकलैर्विनिश्चिते विमतिश्चेद्वदनं विदार्यताम् ।",
          "इति मातृविभर्त्सितो मुखं विकसत्पद्मनिभं व्यदारय: ॥५॥",
          "अयि ते\tO Boy! Of you",
          "सकलै:-विनिश्चिते\tby every one asserted"
        ],
        "iast": [
          "ayi te sakalairviniścite vimatiścedvadanaṃ vidāryatām |",
          "iti mātṛvibhartsito mukhaṃ vikasatpadmanibhaṃ vyadāraya: ||5||",
          "ayi te\tO Boy! Of you",
          "sakalai:-viniścite\tby every one asserted"
        ],
        "malayalam": [
