      "scripts": {
        "devanagari": [
          "अयि देव पुरा किल त्वयि स्वयमुत्तानशये स्तनन्धये ।",
          "परिजृम्भणतो व्यपावृते वदने विश्वमचष्ट वल्लवी ॥१॥",
          "अयि देव\tO Lord!",
          "पुरा किल\tlong ago indeed"
        ],
        "iast": [
          "ayi deva purā kila tvayi svayamuttānaśaye stanandhaye |",
          "parijṛmbhaṇato vyapāvṛte vadane viśvamacaṣṭa vallavī ||1||",
          "ayi deva\tO Lord!",
          "purā kila\tlong ago indeed"
        ],
        "malayalam": [
          "അയി ദേവ പുരാ കില ത്വയി സ്വയമുത്താനശയേ സ്തനന്ധയേ .",
          "പരിജൃംഭണതോ വ്യപാവൃതേ വദനേ വിശ്വമചഷ്ട വല്ലവീ ..1..",
          "ഭഗവാനേ! പണ്ടെങ്ങോ, യശോദയുടെ മടിയിൽ മലർന്ന് കിടന്ന് അവളുടെ മുലകൾ കുടിക്കുമ്പോൾ നീ അലറിവിളിച്ചു. നീ അങ്ങനെ ചെയ്തപ്പോൾ, നിൻ്റെ തുറന്ന വായിൽ, പ്രപഞ്ചം മുഴുവൻ അവൾക്കു വെളിപ്പെടുത്തി."
        ],
