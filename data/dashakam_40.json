      "scripts": {
        "devanagari": [
          "इह च सन्त्यनिमित्तशतानि ते कटकसीम्नि ततो लघु गम्यताम् ।",
          "इति च तद्वचसा व्रजनायको भवदपायभिया द्रुतमाययौ ॥३॥",
          "इह च सन्ति-\tand here there are",
          "अनिमित्त-शतानि\tbad omens in hundreds"
        ],
        "iast": [
          "iha ca santyanimittaśatāni te kaṭakasīmni tato laghu gamyatām |",
          "iti ca tadvacasā vrajanāyako bhavadapāyabhiyā drutamāyayau ||3||",
          "iha ca santi-\tand here there are",
          "animitta-śatāni\tbad omens in hundreds"
        ],
        "malayalam": [
          "ഇഹ ച സന്ത്യനിമിത്തശതാനി തേ കടകസീമ്നി തതോ ലഘു ഗമ്യതാം .",
          "ഇതി ച തദ്വചസാ വ്രജനായകോ ഭവദപായഭിയാ ദ്രുതമായയൗ ..3..",
          "\"ഇവിടെ നൂറുകണക്കിന് മോശം ശകുനങ്ങളുണ്ട്, താമസിയാതെ നിങ്ങളുടെ താമസസ്ഥലത്തും ഇത് സുരക്ഷിതമാകില്ല, അതിനാൽ നിങ്ങൾ ഉടൻ മടങ്ങണം.\" അങ്ങനെ വസുദേവൻ്റെ വാക്കുകളാൽ, നിനക്കുള്ള ആപത്ത് മനസ്സിലാക്കി, നന്ദ വേഗം മടങ്ങി."
        ],
