      "scripts": {
        "devanagari": [
          "अयि सखे तव बालकजन्म मां सुखयतेऽद्य निजात्मजजन्मवत् ।",
          "इति भवत्पितृतां व्रजनायके समधिरोप्य शशंस तमादरात् ॥२॥",
          "अयि सखे\tO friend!",
          "तव बालक जन्म\tto you a son's birth"
        ],
        "iast": [
          "ayi sakhe tava bālakajanma māṃ sukhayate'dya nijātmajajanmavat |",
          "iti bhavatpitṛtāṃ vrajanāyake samadhiropya śaśaṃsa tamādarāt ||2||",
          "ayi sakhe\tO friend!",
          "tava bālaka janma\tto you a son's birth"
        ],
        "malayalam": [
          "അയി സഖേ തവ ബാലകജന്മ മാം സുഖയതേഽദ്യ നിജാത്മജജന്മവത് .",
          "ഇതി ഭവത്പിതൃതാം വ്രജനായകേ സമധിരോപ്യ ശശംസ തമാദരാത് ..2..",
          "\"ഹേ സുഹൃത്തേ, നിനക്ക് ഒരു പുത്രൻ്റെ ജനനം എനിക്ക് ഒരു മകൻ ജനിച്ചതുപോലെ എനിക്ക് സന്തോഷം നൽകുന്നു.\" അങ്ങനെ അവൻ സമർത്ഥമായി നിൻ്റെ പിതൃത്വം നന്ദയിൽ ചാർത്തുകയും വാത്സല്യത്തോടെ അവനെ സ്തുതിക്കുകയും ചെയ്തു."
        ],
        "tamil": []
