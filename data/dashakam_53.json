      "scripts": {
        "devanagari": [
          "उत्तालतालीनिवहे त्वदुक्त्या बलेन धूतेऽथ बलेन दोर्भ्याम् ।",
          "मृदु: खरश्चाभ्यपतत्पुरस्तात् फलोत्करो धेनुकदानवोऽपि ॥४॥",
          "उत्ताल-ताली-निवहे\t(when) the tall palm tree clusters",
          "त्वत्-उक्त्या\tat Thy words"
        ],
        "iast": [
          "uttālatālīnivahe tvaduktyā balena dhūte'tha balena dorbhyām |",
          "mṛdu: kharaścābhyapatatpurastāt phalotkaro dhenukadānavo'pi ||4||",
          "uttāla-tālī-nivahe\t(when) the tall palm tree clusters",
          "tvat-uktyā\tat Thy words"
        ],
        "malayalam": [
          "ഉത്താലതാലീനിവഹേ ത്വദുക്ത്യാ ബലേന ധൂതേഽഥ ബലേന ദോർഭ്യാം .",
          "മൃദു: ഖരശ്ചാഭ്യപതത്പുരസ്താത് ഫലോത്കരോ ധേനുകദാനവോഽപി ..4..",
          "അങ്ങയുടെ വാക്കുകൾ കേട്ട് ബലരാമൻ തൻ്റെ ഇരുകൈകളുടെയും ശക്തിയാൽ ഉയരമുള്ള ഈന്തപ്പനകളുടെ കൂട്ടത്തെ വിറപ്പിച്ചു. മൃദുവായതും പഴുത്തതും കഠിനവും പഴുക്കാത്തതുമായ ഒരു കൂട്ടം പഴങ്ങൾ നിൻ്റെ മുന്നിൽ വീണു. അപ്പോഴാണ് ധേനുകാസുരൻ എന്ന അസുരൻ കഴുതയുടെ രൂപത്തിൽ പ്രത്യക്ഷപ്പെട്ടത്."
        ],
