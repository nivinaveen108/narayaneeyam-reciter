      "scripts": {
        "devanagari": [
          "समुद्यतो धैनुकपालनेऽहं कथं वधं धैनुकमद्य कुर्वे ।",
          "इतीव मत्वा ध्रुवमग्रजेन सुरौघयोद्धारमजीघनस्त्वम् ॥५॥",
          "समुद्यत:\tengaged in",
          "धैनुक-पालने-अहं\tthe cows' protection, I"
        ],
        "iast": [
          "samudyato dhainukapālane'haṃ kathaṃ vadhaṃ dhainukamadya kurve |",
          "itīva matvā dhruvamagrajena suraughayoddhāramajīghanastvam ||5||",
          "samudyata:\tengaged in",
          "dhainuka-pālane-ahaṃ\tthe cows' protection, I"
        ],
        "malayalam": [
          "സമുദ്യതോ ധൈനുകപാലനേഽഹം കഥം വധം ധൈനുകമദ്യ കുർവേ .",
          "ഇതീവ മത്വാ ധ്രുവമഗ്രജേന സുരൗഘയോദ്ധാരമജീഘനസ്ത്വം ..5..",
          "ഞാൻ പശുക്കളെ (ധേനുക) സംരക്ഷിക്കുന്നതിൽ ഏർപ്പെട്ടിരിക്കുകയാണ്, ഇപ്പോൾ എനിക്ക് എങ്ങനെ ധേനുക (പശു) അസുരനെ കൊല്ലാനാകും?' ഇപ്രകാരം വ്യാഖ്യാനിച്ച്, ദേവന്മാരുടെ ശത്രുവായ ധേനുകാസുരനെ നിൻ്റെ ജ്യേഷ്ഠനായ ബലരാമനെ നീ വധിച്ചു."
