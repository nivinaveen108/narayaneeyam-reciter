      "scripts": {
        "devanagari": [
          "हरिं विनिश्चित्य भवन्तमेतान् भवत्पदालोकनबद्धतृष्णान् ॥",
          "निरीक्ष्य विष्णो परमं पदं तद्दुरापमन्यैस्त्वमदीदृशस्तान् ॥८॥",
          "हरिं विनिश्चित्य\tas Hari knowing with certainty",
          "भवन्तम्-एतान्\tThee, to them"
        ],
        "iast": [
          "hariṃ viniścitya bhavantametān bhavatpadālokanabaddhatṛṣṇān ||",
