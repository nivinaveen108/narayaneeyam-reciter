      "scripts": {
        "devanagari": [
          "गर्गोदितो निर्गदितो निजाय वर्गाय तातेन तव प्रभाव: ।",
          "पूर्वाधिकस्त्वय्यनुराग एषामैधिष्ट तावत् बहुमानभार: ॥२॥",
          "गर्ग-उदित:\tas Garg Muni had said",
          "निर्गदित:\twas told"
        ],
        "iast": [
          "gargodito nirgadito nijāya vargāya tātena tava prabhāva: |",
          "pūrvādhikastvayyanurāga eṣāmaidhiṣṭa tāvat bahumānabhāra: ||2||",
          "garga-udita:\tas Garg Muni had said",
          "nirgadita:\twas told"
        ],
        "malayalam": [
          "ഗർഗോദിതോ നിർഗദിതോ നിജായ വർഗായ താതേന തവ പ്രഭാവ: .",
          "പൂർവാധികസ്ത്വയ്യനുരാഗ ഏഷാമൈധിഷ്ട താവത് ബഹുമാനഭാര: ..2..",
          "നിൻ്റെ മഹത്വത്തെക്കുറിച്ച് ഗാർഗ് മഹർഷി പ്രവചിച്ച കാര്യം നിൻ്റെ പിതാവ് തൻ്റെ കുലങ്ങളോടു പറഞ്ഞു. അതോടെ അവരുടെ സ്നേഹവും അങ്ങയോടുള്ള വലിയ ബഹുമാനവും മുമ്പത്തേക്കാൾ വളരെ വർധിച്ചു."
        ],
