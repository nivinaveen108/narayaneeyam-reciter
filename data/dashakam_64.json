      "end": 92.0,
      "scripts": {
        "devanagari": [
          "जगत्त्रयेशे त्वयि गोकुलेशे तथाऽभिषिक्ते सति गोपवाट: ।",
          "नाकेऽपि वैकुण्ठपदेऽप्यलभ्यां श्रियं प्रपेदे भवत: प्रभावात् ॥५॥",
          "जगत्त्रय-ईशे\tO Lord of the three Worlds",
          "त्वयि गोकुलेशे\t(when) Thou as the Lord of Gokula"
        ],
        "iast": [
          "jagattrayeśe tvayi gokuleśe tathā'bhiṣikte sati gopavāṭa: |",
          "nāke'pi vaikuṇṭhapade'pyalabhyāṃ śriyaṃ prapede bhavata: prabhāvāt ||5||",
          "jagattraya-īśe\tO Lord of the three Worlds",
          "tvayi gokuleśe\t(when) Thou as the Lord of Gokula"
