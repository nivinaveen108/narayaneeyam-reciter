      "scripts": {
        "devanagari": [
          "शाक्वरोऽथ जगतीधृतिहारी मूर्तिमेष बृहतीं प्रदधान: ।",
          "पङ्क्तिमाशु परिघूर्ण्य पशूनां छन्दसां निधिमवाप भवन्तम् ॥७॥",
          "शाक्वर:-अथ\t(this) bull then",
          "जगती-धृति-हारी\t(who was) the world's peace plunderer"
        ],
        "iast": [
          "śākvaro'tha jagatīdhṛtihārī mūrtimeṣa bṛhatīṃ pradadhāna: |",
          "paṅktimāśu parighūrṇya paśūnāṃ chandasāṃ nidhimavāpa bhavantam ||7||",
