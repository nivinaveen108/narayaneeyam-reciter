        "devanagari": [
          "कदापि गोपै: सह काननान्ते निलायनक्रीडनलोलुपं त्वाम् ।",
          "मयात्मज: प्राप दुरन्तमायो व्योमाभिधो व्योमचरोपरोधी ॥८॥",
          "कदापि\tonce",
          "गोपै: सह\twith the Gopas"
        ],
        "iast": [
          "kadāpi gopai: saha kānanānte nilāyanakrīḍanalolupaṃ tvām |",
          "mayātmaja: prāpa durantamāyo vyomābhidho vyomacaroparodhī ||8||",
          "kadāpi\tonce",
          "gopai: saha\twith the Gopas"
