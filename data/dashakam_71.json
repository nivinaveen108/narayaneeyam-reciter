      "scripts": {
        "devanagari": [
          "स चोरपालायितवल्लवेषु चोरायितो गोपशिशून् पशूंश्च",
          "गुहासु कृत्वा पिदधे शिलाभिस्त्वया च बुद्ध्वा परिमर्दितोऽभूत् ॥९॥",
          "स\the (Vyoma)",
          "चोर-पालायित-वल्लवेषु\tamong the thieves and the policemen boys"
        ],
        "iast": [
          "sa corapālāyitavallaveṣu corāyito gopaśiśūn paśūṃśca",
          "guhāsu kṛtvā pidadhe śilābhistvayā ca buddhvā parimardito'bhūt ||9||",
          "sa\the (Vyoma)",
          "cora-pālāyita-vallaveṣu\tamong the thieves and the policemen boys"
        ],
        "malayalam": [
          "സ ചോരപാലായിതവല്ലവേഷു ചോരായിതോ ഗോപശിശൂൻ പശൂംശ്ച",
          "ഗുഹാസു കൃത്വാ പിദധേ ശിലാഭിസ്ത്വയാ ച ബുദ്ധ്വാ പരിമർദിതോഽഭൂത് ..9..",
          "കളിയിൽ കള്ളനായും പോലീസുകാരായും കളിക്കുന്ന ആൺകുട്ടികളുടെ ഇടയിൽ അയാൾ ഇടകലർന്നു. കള്ളനായി കളിക്കുന്ന വ്യോമൻ ഗോപബാലന്മാരെയും പശുക്കളെയും ഒരു ഗുഹയിലാക്കി ഗുഹയുടെ വായ ഒരു കല്ലുകൊണ്ട് അടച്ചു. അങ്ങ് സ്ഥിതിഗതികൾ മനസ്സിലാക്കിയതുപോലെ, നീയാൽ വ്യോമൻ കൊല്ലപ്പെട്ടു."
        ],
