      "scripts": {
        "devanagari": [
          "स्फुरत्परानन्दरसात्मकेन त्वया समासादितभोगलीला: ।",
          "असीममानन्दभरं प्रपन्ना महान्तमापुर्मदमम्बुजाक्ष्य: ॥१॥",
          "स्फुरत्-परानन्द-\tresplendent of the supreme bliss",
          "रसात्मकेन\tand the pure Essence embodied"
        ],
        "iast": [
          "sphuratparānandarasātmakena tvayā samāsāditabhogalīlā: |",
          "asīmamānandabharaṃ prapannā mahāntamāpurmadamambujākṣya: ||1||",
          "sphurat-parānanda-\tresplendent of the supreme bliss",
          "rasātmakena\tand the pure Essence embodied"
        ],
        "malayalam": [
          "സ്ഫുരത്പരാനന്ദരസാത്മകേന ത്വയാ സമാസാദിതഭോഗലീലാ: .",
          "അസീമമാനന്ദഭരം പ്രപന്നാ മഹാന്തമാപുർമദമംബുജാക്ഷ്യ: ..1..",
          "ഉജ്ജ്വലമായ പരമമായ ആനന്ദത്തിൻ്റെ ശുദ്ധമായ മൂർത്തമായ സാരാംശമായ, താമരക്കണ്ണുകളുള്ള പെൺകുട്ടികൾക്ക് നിന്നോടൊപ്പമുള്ള ആഹ്ലാദകരമായ കളിയിൽ പങ്കെടുക്കാൻ അനുവദിച്ചു. അവർ അതിരുകളില്ലാത്ത ആനന്ദത്തിൽ മുഴുകി, അതിനാൽ അവർ വലിയ അഭിമാനത്തിനും സ്വയം പ്രാധാന്യത്തിനും ഇരയായി."
        ],
