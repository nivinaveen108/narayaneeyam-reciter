      "scripts": {
        "devanagari": [
          "निरीक्षितोऽयं सखि पङ्कजाक्ष: पुरो ममेत्याकुलमालपन्ती ।",
          "त्वां भावनाचक्षुषि वीक्ष्य काचित्तापं सखीनां द्विगुणीचकार ॥६॥",
          "निरीक्षित:-\tis seen",
          "अयं सखि\tthis, O friend"
        ],
        "iast": [
          "nirīkṣito'yaṃ sakhi paṅkajākṣa: puro mametyākulamālapantī |",
          "tvāṃ bhāvanācakṣuṣi vīkṣya kācittāpaṃ sakhīnāṃ dviguṇīcakāra ||6||",
          "nirīkṣita:-\tis seen",
          "ayaṃ sakhi\tthis, O friend"
        ],
        "malayalam": [
          "നിരീക്ഷിതോഽയം സഖി പങ്കജാക്ഷ: പുരോ മമേത്യാകുലമാലപന്തീ .",
          "ത്വാം ഭാവനാചക്ഷുഷി വീക്ഷ്യ കാചിത്താപം സഖീനാം ദ്വിഗുണീചകാര ..6..",
          "ഓ സുഹൃത്തേ! ഈ താമര കൃഷ്ണനെ കണ്ണടച്ചു, ഞാൻ എൻ്റെ മുമ്പിൽ കാണുന്നു,' ഗോപികമാരിലൊരാൾ തൻ്റെ ഭാവനാ ദർശനത്താൽ അങ്ങയെ കണ്ട് ആവേശത്തോടെ പ്രഖ്യാപിച്ചു. ഇത് അവളുടെ സുഹൃത്തുക്കളുടെ കഷ്ടപ്പാടുകൾ ഇരട്ടിയാക്കി."
        ],
        "tamil": []
