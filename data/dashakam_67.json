      "scripts": {
        "devanagari": [
          "हा चूत हा चम्पक कर्णिकार हा मल्लिके मालति बालवल्य: ।",
          "किं वीक्षितो नो हृदयैकचोर: इत्यादि तास्त्वत्प्रवणा विलेपु: ॥५॥",
          "हा चूत\tO mango",
          "हा चम्पक\tO champaka"
        ],
        "iast": [
          "hā cūta hā campaka karṇikāra hā mallike mālati bālavalya: |",
          "kiṃ vīkṣito no hṛdayaikacora: ityādi tāstvatpravaṇā vilepu: ||5||",
          "hā cūta\tO mango",
          "hā campaka\tO champaka"
        ],
        "malayalam": [
          "ഹാ ചൂത ഹാ ചമ്പക കർണികാര ഹാ മല്ലികേ മാലതി ബാലവല്യ: .",
          "കിം വീക്ഷിതോ നോ ഹൃദയൈകചോര: ഇത്യാദി താസ്ത്വത്പ്രവണാ വിലേപു: ..5..",
          "\"ഹേ മാമ്പഴമേ, ഹേ ചാമ്പക, ഹേ കർണ്ണികാ, ഓ മല്ലിക, മാലതീ, ഇളം വള്ളിച്ചെടികളേ, ഞങ്ങളുടെ ഹൃദയം കവർന്നവനെ നീ കണ്ടോ?' അങ്ങനെ തികഞ്ഞ ഭക്തർ ഫലവൃക്ഷങ്ങളോടും പൂമരങ്ങളോടും ചോദിച്ചു വിലപിച്ചു."
        ],
