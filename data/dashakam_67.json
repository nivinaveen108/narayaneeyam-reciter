        ],
        "iast": [
          "tathā vyathāsaṅkulamānasānāṃ vrajāṅganānāṃ karuṇaikasindho |",
          "jagattrayīmohanamohanātmā tvaṃ prādurāsīrayi mandahāsī ||9||",
          "tathā vyathā-saṅkula-\tthus pain overcome",
          "mānasānām\tminded"
