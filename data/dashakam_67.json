      "scripts": {
        "devanagari": [
          "निलीयतेऽसौ मयि मय्यमायं रमापतिर्विश्वमनोभिराम: ।",
          "इति स्म सर्वा: कलिताभिमाना निरीक्ष्य गोविन्द् तिरोहितोऽभू: ॥२॥",
          "निलीयते-\tis engrossed",
          "असौ मयि\tthis (Krishna) in me"
        ],
        "iast": [
          "nilīyate'sau mayi mayyamāyaṃ ramāpatirviśvamanobhirāma: |",
          "iti sma sarvā: kalitābhimānā nirīkṣya govind tirohito'bhū: ||2||",
          "nilīyate-\tis engrossed",
          "asau mayi\tthis (Krishna) in me"
        ],
        "malayalam": [
          "നിലീയതേഽസൗ മയി മയ്യമായം രമാപതിർവിശ്വമനോഭിരാമ: .",
          "ഇതി സ്മ സർവാ: കലിതാഭിമാനാ നിരീക്ഷ്യ ഗോവിന്ദ് തിരോഹിതോഽഭൂ: ..2..",
          "ലക്ഷ്മിയുടെ പത്നിയും ലോകത്തിൻ്റെ മുഴുവൻ മനസ്സുകളെ വശീകരിക്കുന്നവനുമായ ഈ കൃഷ്ണൻ എന്നിൽ മുഴുകിയിരിക്കുന്നു. അഹങ്കാരത്തോടെ എല്ലാവരും അങ്ങനെ ചിന്തിച്ചു. ഹേ ഗോവിന്ദ! ഇത് അറിഞ്ഞുകൊണ്ട് നീ അവരുടെ ഇടയിൽ നിന്ന് അപ്രത്യക്ഷനായി."
        ],
