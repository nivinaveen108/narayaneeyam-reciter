    {
      "shloka": 7,
      "start": 102.0,
      "end": 119.0,
      "scripts": {
        "devanagari": [
          "त्वदात्मिकास्ता यमुनातटान्ते तवानुचक्रु: किल चेष्टितानि ।",
          "विचित्य भूयोऽपि तथैव मानात्त्वया विमुक्तां ददृशुश्च राधाम् ॥७॥",
          "त्वत्-आत्मिका:-ता\twith Thee identified, they",
          "यमुना-तट-अन्ते\ton the banks of the Yamunaa"
        ],
        "iast": [
          "tvadātmikāstā yamunātaṭānte tavānucakru: kila ceṣṭitāni |",
          "vicitya bhūyo'pi tathaiva mānāttvayā vimuktāṃ dadṛśuśca rādhām ||7||",
          "tvat-ātmikā:-tā\twith Thee identified, they",
          "yamunā-taṭa-ante\ton the banks of the Yamunaa"
        ],
        "malayalam": [
          "ത്വദാത്മികാസ്താ യമുനാതടാന്തേ തവാനുചക്രു: കില ചേഷ്ടിതാനി .",
          "വിചിത്യ ഭൂയോഽപി തഥൈവ മാനാത്ത്വയാ വിമുക്താം ദദൃശുശ്ച രാധാം ..7..",
          "അവർ നിങ്ങളുമായി പൂർണ്ണമായും താദാത്മ്യം പ്രാപിച്ചിരുന്നു. അതിനാൽ, യമുനാ നദിയുടെ തീരത്ത് അവർ നിൻ്റെ പ്രവൃത്തികൾ അനുകരിക്കുകയും അനുകരിക്കുകയും ചെയ്തു. അവർ നിന്നെ വീണ്ടും തിരഞ്ഞു നടന്നു, അഹങ്കാരം നിമിത്തം നിന്നിൽ നിന്ന് വേർപിരിഞ്ഞ രാധയെ അവർ കണ്ടു."
        ],
        "tamil": []
