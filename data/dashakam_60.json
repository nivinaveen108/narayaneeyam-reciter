      "scripts": {
        "devanagari": [
          "अयि जीव चिरं किशोर नस्तव दासीरवशीकरोषि किम् ।",
          "प्रदिशाम्बरमम्बुजेक्षणेत्युदितस्त्वं स्मितमेव दत्तवान् ॥७॥",
          "अयि जीव चिरं\tO may you live long",
          "किशोर\tdear boy"
        ],
        "iast": [
          "ayi jīva ciraṃ kiśora nastava dāsīravaśīkaroṣi kim |",
          "pradiśāmbaramambujekṣaṇetyuditastvaṃ smitameva dattavān ||7||",
          "ayi jīva ciraṃ\tO may you live long",
          "kiśora\tdear boy"
        ],
        "malayalam": [
          "അയി ജീവ ചിരം കിശോര നസ്തവ ദാസീരവശീകരോഷി കിം .",
          "പ്രദിശാംബരമംബുജേക്ഷണേത്യുദിതസ്ത്വം സ്മിതമേവ ദത്തവാൻ ..7..",
          "ഓ പ്രിയ കുട്ടി! ദീർഘായുസ്സുണ്ടാകട്ടെ. ഞങ്ങൾ നിങ്ങളുടെ കൈവേലക്കാരാണ്. എന്തിനാ ഞങ്ങളെ ഇങ്ങനെ കളിയാക്കുന്നത്? താമരക്കണ്ണുള്ളവനേ! ഞങ്ങളുടെ വസ്ത്രം തരൂ.' ഇങ്ങനെ പറഞ്ഞപ്പോൾ നീ ഒരു പുഞ്ചിരി മാത്രം നൽകി."
