      "scripts": {
        "devanagari": [
          "मदनातुरचेतसोऽन्वहं भवदङ्घ्रिद्वयदास्यकाम्यया ।",
          "यमुनातटसीम्नि सैकतीं तरलाक्ष्यो गिरिजां समार्चिचन् ॥१॥",
          "मदन-आतुर-चेतस:-\twith minds overcome by the god of love",
          "अन्वहं\teveryday"
        ],
        "iast": [
          "madanāturacetaso'nvahaṃ bhavadaṅghridvayadāsyakāmyayā |",
          "yamunātaṭasīmni saikatīṃ taralākṣyo girijāṃ samārcican ||1||",
          "madana-ātura-cetasa:-\twith minds overcome by the god of love",
          "anvahaṃ\teveryday"
        ],
        "malayalam": [
          "മദനാതുരചേതസോഽന്വഹം ഭവദംഘ്രിദ്വയദാസ്യകാമ്യയാ .",
          "യമുനാതടസീമ്നി സൈകതീം തരലാക്ഷ്യോ ഗിരിജാം സമാർചിചൻ ..1..",
          "കാമദേവനാൽ കീഴടക്കപ്പെട്ട കണ്ണുകളുള്ള വ്രജയിലെ സുന്ദരികളായ പെൺകുട്ടികൾ അങ്ങയുടെ രണ്ട് താമരകളെ സേവിക്കാൻ ആഗ്രഹിച്ചു. അതിനായി എല്ലാ ദിവസവും യമുനയുടെ തീരത്ത് അവർ ഗിരിജ ദേവിയുടെ മണൽ പ്രതിമ ഉണ്ടാക്കി ആരാധിച്ചു."
        ],
