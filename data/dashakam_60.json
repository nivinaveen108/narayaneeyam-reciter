      "start": 16.0,
      "end": 32.0,
      "scripts": {
        "devanagari": [
          "तव नामकथारता: समं सुदृश: प्रातरुपागता नदीम् ।",
          "उपहारशतैरपूजयन् दयितो नन्दसुतो भवेदिति ॥२॥",
          "तव\tThy",
          "नाम-कथा-रता:\tname and deeds always immersed in"
        ],
        "iast": [
          "tava nāmakathāratā: samaṃ sudṛśa: prātarupāgatā nadīm |",
          "upahāraśatairapūjayan dayito nandasuto bhavediti ||2||",
          "tava\tThy",
          "nāma-kathā-ratā:\tname and deeds always immersed in"
        ],
        "malayalam": [
          "തവ നാമകഥാരതാ: സമം സുദൃശ: പ്രാതരുപാഗതാ നദീം .",
          "ഉപഹാരശതൈരപൂജയൻ ദയിതോ നന്ദസുതോ ഭവേദിതി ..2..",
          "സുന്ദരികളായ എല്ലാ പെൺകുട്ടികളും എപ്പോഴും നിൻ്റെ നാമം ജപിക്കുന്നതിലും നിൻ്റെ പ്രവൃത്തികൾ വിവരിക്കുന്നതിലും മുഴുകിയിരുന്നു. രാവിലെ അവർ നദിയിൽ പോയി നൂറുകണക്കിന് വഴിപാടുകളുമായി ഗിരിജ ദേവിയെ ആരാധിക്കുകയും നന്ദയുടെ മകൻ കൃഷ്ണൻ തങ്ങളുടെ ഭർത്താവാകാൻ പ്രാർത്ഥിക്കുകയും ചെയ്യും."
        ],
