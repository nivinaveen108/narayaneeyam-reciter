      "scripts": {
        "devanagari": [
          "रामसख: क्वापि दिने कामद भगवन् गतो भवान् विपिनम् ।",
          "सूनुभिरपि गोपानां धेनुभिरभिसंवृतो लसद्वेष: ॥१॥",
          "रामसख:\tin Balaraama's company",
          "क्वापि दिने\tone day"
        ],
        "iast": [
          "rāmasakha: kvāpi dine kāmada bhagavan gato bhavān vipinam |",
          "sūnubhirapi gopānāṃ dhenubhirabhisaṃvṛto lasadveṣa: ||1||",
          "rāmasakha:\tin Balaraama's company",
          "kvāpi dine\tone day"
        ],
        "malayalam": [
          "രാമസഖ: ക്വാപി ദിനേ കാമദ ഭഗവൻ ഗതോ ഭവാൻ വിപിനം .",
          "സൂനുഭിരപി ഗോപാനാം ധേനുഭിരഭിസംവൃതോ ലസദ്വേഷ: ..1..",
          "ഭഗവാനേ! ആഗ്രഹ സാധകനായ നീ ഒരു ദിവസം ശയനവസ്ത്രധാരിയായി ബലരാമനോടൊപ്പം കാട്ടിലേക്ക് പോയി. ഗോപ പുത്രന്മാരും പശുക്കളും നിന്നെ വളഞ്ഞ് അനുഗമിച്ചു."
        ],
