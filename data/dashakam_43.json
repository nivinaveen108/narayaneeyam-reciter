        "devanagari": [
          "तावत् स दानववरोऽपि च दीनमूर्ति-",
          "र्भावत्कभारपरिधारणलूनवेग: ।",
          "सङ्कोचमाप तदनु क्षतपांसुघोषे",
          "घोषे व्यतायत भवज्जननीनिनाद: ॥४॥"
        ],
        "iast": [
          "tāvat sa dānavavaro'pi ca dīnamūrti-",
          "rbhāvatkabhāraparidhāraṇalūnavega: |",
          "saṅkocamāpa tadanu kṣatapāṃsughoṣe",
          "ghoṣe vyatāyata bhavajjananīnināda: ||4||"
        ],
        "malayalam": [
          "താവത് സ ദാനവവരോഽപി ച ദീനമൂർതി-",
